# Copy this file to examples/.env and fill in the values for your local
# Keyforge server checkout. See examples/README.md for full setup steps.

# Server origin (no trailing slash, no /api/v1 suffix — the client and this
# suite's admin API calls append their own paths).
KEYFORGE_BASE_URL=http://localhost:3000

# Admin login used to bootstrap or authenticate against the admin API.
# If no admin account exists yet on the target server, setup-fixtures.js
# registers one with these exact credentials (works once, on a fresh DB).
# If an admin already exists, these must match it.
KEYFORGE_ADMIN_EMAIL=you@example.com
KEYFORGE_ADMIN_PASSWORD=change-me-please

# Path to the Keyforge server's signing public key PEM, from your Keyforge
# server checkout (e.g. <keyforge-server-checkout>/keys/public-v1.pem).
# Generate one there first if it doesn't exist yet:
#   npm run generate-signing-keypair -- --version 1
KEYFORGE_PUBLIC_KEY_PATH=/path/to/Keyforge/keys/public-v1.pem

# Must match the server's LICENSE_SIGNING_KEY_VERSION and the key file above.
KEYFORGE_KEY_VERSION=1
